DATABASE_URL=postgresql+psycopg://easycrm:change-this-local-password@localhost:5432/easycrm
POSTGRES_USER=easycrm
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=easycrm
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
SESSION_TTL_SECONDS=3600
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Gemini models are discovered for GEMINI_API_KEY; no static GEMINI_MODELS list.
# NVIDIA_MODELS is an explicit chat-capable allowlist, checked by Refresh Models.
NVIDIA_MODELS=["nvidia/nemotron-3-ultra-550b-a55b","nvidia/llama-3.3-nemotron-super-49b-v1.5"]
AI_TIMEOUT_SECONDS=60
# Per-process discovery cache TTL; Refresh Models bypasses it.
AI_MODELS_CACHE_SECONDS=300
